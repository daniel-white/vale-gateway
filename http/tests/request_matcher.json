{
  "method": "PATCH",
  "path": {
    "regex": "^/api/v1/.*$"
  },
  "headers": [
    {
      "name": "content-type",
      "value": "application/json"
    },
    {
      "name": "accept",
      "regex": "^text/.*"
    }
  ],
  "queryParams": [
    {
      "name": "pageSize",
      "regex": "^\\d$"
    }
  ]
}
{
  "name": "api-v1-patch-route",
  "matcher": {
    "method": {
      "method": "PATCH"
    },
    "path": {
      "regex": "^/api/v1/.*$"
    },
    "headers": [
      {
        "name": "content-type",
        "value": "application/json"
      },
      {
        "name": "accept",
        "regex": "^text/.*"
      }
    ],
    "queryParams": [
      {
        "name": "pageSize",
        "regex": "^\\d$"
      }
    ]
  },
  "filters": [
    {
      "kind": "requestHeaderModifier",
      "add": {
        "x-api-version": "v1",
        "x-request-id": "generated-id"
      },
      "set": {
        "user-agent": "vale-gateway/1.0"
      },
      "remove": ["x-forwarded-for"]
    },
    {
      "kind": "responseHeaderModifier",
      "add": {
        "x-response-time": "auto",
        "cache-control": "no-cache"
      },
      "set": {
        "server": "vale-gateway"
      },
      "remove": ["x-powered-by"]
    },
    {
      "kind": "accessControl",
      "ref": "api-access-policy"
    },
    {
      "kind": "backendUriRewriter",
      "scheme": "https",
      "host": "backend-api.internal",
      "port": 8080,
      "path": {
        "replacePrefixWith": "/internal/api/v1"
      }
    }
  ],
  "policies": {
    "timeouts": {
      "request": {
        "durationSecs": 30.0
      },
      "backendRequest": {
        "durationSecs": 25.0
      }
    },
    "retries": {
      "codes": [
        500,
        502,
        503,
        504
      ],
      "maxAttempts": 3,
      "backoffSecs": 1000
    }
  }
}
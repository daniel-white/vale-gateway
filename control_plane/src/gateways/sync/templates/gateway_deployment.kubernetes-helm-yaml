apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app.kubernetes.io/name: vale-gateway
    app.kubernetes.io/instance: {{ .gateway_name | quote }}
    app.kubernetes.io/component: gateway
    app.kubernetes.io/managed-by: vale-gateway-controller
spec:
  replicas: {{ .replicas | default 1 }}
  selector:
    matchLabels:
      app.kubernetes.io/name: vale-gateway
      app.kubernetes.io/instance: {{ .gateway_name | quote }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: vale-gateway
        app.kubernetes.io/instance: {{ .gateway_name | quote }}
        app.kubernetes.io/component: gateway
    spec:
      volumes:
        - name: config
          configMap:
            name: {{ .configmap_name | quote }}
            items:
              - key: gateway.yaml
                path: gateway.yaml
      containers:
        - name: gateway
          image: {{ .image_repository | default "vale-gateway" }}:{{ .image_tag | default "latest" }}
          imagePullPolicy: {{ .image_pull_policy | default "IfNotPresent" }}
          command:
            - /usr/local/bin/vg-gateway
          args:
            - --config
            - /etc/vale-gateway/gateway.yaml
          volumeMounts:
            - mountPath: /etc/vale-gateway
              name: config
              readOnly: true
          env:
            - name: POD_NAMESPACE
              valueFrom:
                fieldRef:
                  fieldPath: metadata.namespace
            - name: POD_NAME
              valueFrom:
                fieldRef:
                  fieldPath: metadata.name
            - name: POD_UID
              valueFrom:
                fieldRef:
                  fieldPath: metadata.uid
            - name: GATEWAY_NAME
              value: {{ .gateway_name | quote }}
          ports:
            - name: http
              containerPort: 8080
              protocol: TCP
          readinessProbe:
            httpGet:
              path: /health/ready
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 3
          livenessProbe:
            httpGet:
              path: /health/live
              port: http
            initialDelaySeconds: 30
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 3